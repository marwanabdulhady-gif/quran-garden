{
  "name": "huroof-play",
  "private": true,
  "version": "1.0.0",
  "description": "مغامرة الحروف — لعبة عربية للأطفال: اسحب الحرف إلى الحيوان الذي يبدأ به",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node tests/ssr-smoke.mjs",
    "lint": "eslint src tests scripts --ext .js,.jsx,.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,mjs,jsx}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,mjs,jsx}\" \"scripts/**/*.mjs\"",
    "e2e": "npm run build && node scripts/e2e.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "happy-dom": "^15.11.7",
    "prettier": "^3.9.9",
    "puppeteer-core": "^23.11.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
