{
  "name": "quran-garden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "precache:check": "node tools/salman-precache-check.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ssr": "node tests/ssr-smoke.mjs",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"tests/**/*.{js,mjs,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"tests/**/*.{js,mjs,jsx}\"",
    "videos:build": "node tools/videos/build-videos.mjs",
    "videos:dry": "node tools/videos/build-videos.mjs --dry-run",
    "videos:check": "node tools/videos/check-videos.mjs",
    "videos:preview": "npx --yes hyperframes@0.8.149 preview videos",
    "videos:render": "node tools/videos/render-all.mjs",
    "videos:browser": "npx --yes hyperframes@0.8.149 browser ensure"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gsap": "^3.15.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.9.9",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  }
}
